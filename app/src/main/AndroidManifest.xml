<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".QuiApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Qui">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Qui">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Magnet links, mirroring qui's web protocol handler registration -->
            <intent-filter android:label="@string/add_to_qui">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>

            <!-- .torrent files shared or opened from other apps -->
            <intent-filter android:label="@string/add_to_qui">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>

            <intent-filter android:label="@string/add_to_qui">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>

            <intent-filter android:label="@string/add_to_qui">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- One receiver per size: the picker lists them separately so nobody has to
             know a widget can be resized. They share StatsWidgetProvider. -->
        <receiver
            android:name=".widget.QuiSpeedWidgetProvider"
            android:exported="false"
            android:label="@string/widget_speed_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.qui.android.widget.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_speed_info" />
        </receiver>

        <receiver
            android:name=".widget.QuiOverviewWidgetProvider"
            android:exported="false"
            android:label="@string/widget_overview_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.qui.android.widget.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_overview_info" />
        </receiver>

        <receiver
            android:name=".widget.QuiWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- The refresh button broadcasts to the provider itself. -->
                <action android:name="dev.qui.android.widget.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>

        <receiver
            android:name=".widget.QuiTorrentsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_torrents_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.qui.android.widget.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_torrents_info" />
        </receiver>

        <!-- The launcher fires this once a pinned widget is actually placed; its
             silence is how Settings knows the request went nowhere. -->
        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false" />

        <!-- BIND_REMOTEVIEWS keeps the row adapter reachable by the launcher only. -->
        <service
            android:name=".widget.TorrentsWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>

</manifest>
