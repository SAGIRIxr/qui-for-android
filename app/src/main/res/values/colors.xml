<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- qui default theme background token, light mode: oklch(1 0 0) -->
    <color name="window_background">#FFFFFFFF</color>
    <color name="ic_launcher_background">#171717</color>

    <!-- Widget palette. RemoteViews cannot read the Compose theme, so these track
         qui's default theme tokens by hand: card, foreground, muted-foreground,
         chart-2 (download) and chart-3 (upload). -->
    <color name="widget_background">#FFFFFFFF</color>
    <color name="widget_foreground">#FF0A0A0A</color>
    <color name="widget_muted">#FF737373</color>
    <color name="widget_download">#FF2F7DD1</color>
    <color name="widget_upload">#FF3D9A50</color>
    <!-- Tile fill, hairline and progress track: qui's muted / border tokens. -->
    <color name="widget_surface">#FFF5F5F5</color>
    <color name="widget_border">#FFE5E5E5</color>
    <color name="widget_track">#FFE5E5E5</color>
    <color name="widget_error">#FFD4453C</color>
    <color name="widget_paused">#FF8A8A8A</color>
</resources>
