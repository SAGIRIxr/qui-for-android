<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- HyperOS, Pixel Launcher and One UI all publish their own widget radius here,
         so borrowing it is what makes the card sit flush with the launcher's own. -->
    <dimen name="widget_corner_radius">@android:dimen/system_app_widget_background_radius</dimen>
    <dimen name="widget_inner_radius">@android:dimen/system_app_widget_inner_radius</dimen>
</resources>
