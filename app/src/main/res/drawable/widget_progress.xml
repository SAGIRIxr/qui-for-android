<?xml version="1.0" encoding="utf-8"?>
<!--
  ProgressBar drawable for the list widget. A plain layer-list keeps it identical on
  every launcher; progress tinting through RemoteViews needs API 31, and a widget row
  is not worth a version fork.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_track" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_download" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
