<?xml version="1.0" encoding="utf-8"?>
<!--
  30 minutes is the floor the platform enforces for widget self-updates, so the
  widget is a glance rather than a live readout; the app refreshes it whenever it
  polls the dashboard, which is what keeps it current in practice.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_speeds"
    android:minHeight="40dp"
    android:minWidth="110dp"
    android:previewLayout="@layout/widget_speeds"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
