<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 0 on purpose: the platform clamps it to 30 minutes, so the
  refresh schedule is WidgetRefreshWorker's instead, which honours the interval chosen
  in Settings and waits for connectivity rather than failing without it.

  minWidth/minHeight cover the 2x1 footprint so HyperOS offers every stock size chip
  from 2x1 up to 4x3; the responsive layouts in WidgetViews decide what fits.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_stats_wide"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:maxResizeHeight="300dp"
    android:maxResizeWidth="330dp"
    android:previewLayout="@layout/widget_stats_wide"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
